# ============================================================
# Firefly IoT deployment environment template
# Copy to `.env` and update values for your environment.
# ============================================================

# ---------- Global ----------
COMPOSE_PROJECT_NAME=firefly-iot
DEPLOY_ENV=dev
# Current shared environment is still in development.
# Switch to `prod` only for formal production deployment.
# Docker-style .env parsing is supported here, so values with spaces can stay unquoted.
JAVA_OPTS=-Xms256m -Xmx512m
# Keep persistent volumes on stable names so the current compose project can
# take over hosts that were once started from another directory/project name.
POSTGRES_VOLUME_NAME=firefly-postgres-data
REDIS_VOLUME_NAME=firefly-redis-data
KAFKA_VOLUME_NAME=firefly-kafka-data
MINIO_VOLUME_NAME=firefly-minio-data
CONNECTOR_MQTT_VOLUME_NAME=firefly-connector-mqtt-data

# ---------- Prebuilt application images ----------
# `deploy.sh release` reads these values when the stack is deployed from
# GitHub Actions / GHCR instead of being built from source on the host.
APP_IMAGE_REGISTRY=ghcr.io
APP_IMAGE_NAMESPACE=
APP_IMAGE_TAG=latest

# ---------- PostgreSQL ----------
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=firefly_iot
POSTGRES_USER=firefly
POSTGRES_PASSWORD=firefly123
POSTGRES_MAX_CONNECTIONS=300
DB_POOL_MAX_SIZE=5
DB_POOL_MIN_IDLE=1
DB_POOL_CONNECTION_TIMEOUT_MS=10000
DB_POOL_IDLE_TIMEOUT_MS=60000
DB_POOL_MAX_LIFETIME_MS=1800000
FLYWAY_CONNECT_RETRIES=30

# ---------- Redis ----------
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=

# ---------- Kafka ----------
# 单 broker（默认 docker-compose.prod.yml）地址。
# 启用 3 broker HA overlay（docker-compose.kafka-ha.yml）时改为：
#   KAFKA_SERVERS=kafka1:9092,kafka2:9092,kafka3:9092
#   KAFKA_TOPIC_REPLICATION_FACTOR=3
# 启用步骤（先起 HA broker -> 预建 topic -> 起业务服务）见：
#   docs/operations/connector-management-auth-kafka-reliability.md
KAFKA_SERVERS=kafka:9092
KAFKA_ADVERTISED_HOST=kafka
# kafka-init 预建 topic 的分区数（默认 3）。
KAFKA_TOPIC_PARTITIONS=3
# 预建 topic 的副本数：单 broker 必须为 1；HA overlay（3 broker）下改为 3。
KAFKA_TOPIC_REPLICATION_FACTOR=1
# 每个 @KafkaListener 的并发消费线程数；建议不超过 topic 分区数。
KAFKA_LISTENER_CONCURRENCY=2

# ---------- Nacos ----------
NACOS_ADDR=nacos:8848
NACOS_NAMESPACE=firefly-dev

# ---------- MinIO ----------
MINIO_ENDPOINT=http://minio:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin123
MINIO_BUCKET=firefly-iot

# ---------- Sentinel ----------
SENTINEL_DASHBOARD=sentinel:8858

# ---------- JWT ----------
# 生产必须显式提供一组匹配的 RSA 密钥（Base64）。
# 私钥：PKCS#8 DER 后 Base64；公钥：X.509 DER 后 Base64。
# 生成示例：
#   openssl genpkey -algorithm RSA -pkeyopt rsa_keygen_bits:2048 -out key.pem
#   openssl pkcs8 -topk8 -nocrypt -in key.pem -outform DER | base64
#   openssl rsa -in key.pem -pubout -outform DER | base64
JWT_PRIVATE_KEY=
JWT_PUBLIC_KEY=

# ---------- Internal service token ----------
# 服务间内部接口（/api/v1/internal/**）共享令牌，生产必须配置；
# 缺失时内部接口一律拒绝，依赖内部接口的跨服务调用会失败。
FIREFLY_INTERNAL_TOKEN=
# 网关重建权限缓存时访问 system 的地址
FIREFLY_SYSTEM_URL=http://firefly-system:8081

# ---------- OpenAPI / AppKey ----------
# Required for formal production deployment. Use a unique 32-byte raw key or a
# base64 value that decodes to 32 bytes; do not reuse the development default.
FIREFLY_OPENAPI_APPKEY_SECRET_ENCRYPT_KEY=
FIREFLY_OPENAPI_APPKEY_SIGNATURE_WINDOW_SECONDS=300

# ---------- Host log persistence ----------
# Container rebuilds keep historical Java/nginx logs here for easier remote
# troubleshooting. Relative paths are resolved from deploy/.
APP_LOG_ROOT=./runtime/logs

# ---------- Embedded MQTT in firefly-connector ----------
FIREFLY_HTTP_PRESENCE_TIMEOUT_SECONDS=300
FIREFLY_HTTP_PRESENCE_SWEEP_INTERVAL_SECONDS=30
FIREFLY_MQTT_ENABLED=true
FIREFLY_MQTT_HOST=0.0.0.0
FIREFLY_MQTT_PORT=1883
FIREFLY_MQTT_ALLOW_ANONYMOUS=false
FIREFLY_MQTT_PERSISTENCE_ENABLED=false
FIREFLY_MQTT_DATA_PATH=data/mqtt
FIREFLY_MQTT_MAX_MESSAGE_SIZE=65536
# TLS 监听（可选，生产建议启用）：启用时必须提供 keystore 路径与密码。
# 容器内证书统一放到 ./certs 目录并挂载到 /etc/firefly/certs，路径示例见下方注释。
FIREFLY_MQTT_SSL_ENABLED=false
FIREFLY_MQTT_SSL_PORT=8883
FIREFLY_MQTT_KEY_STORE_TYPE=JKS
# 例：/etc/firefly/certs/mqtt-server.jks
FIREFLY_MQTT_KEY_STORE_PATH=
FIREFLY_MQTT_KEY_STORE_PASSWORD=
FIREFLY_MQTT_KEY_MANAGER_PASSWORD=
# 双向认证（mTLS）：NONE=仅服务端证书；OPTIONAL=请求但不强制；REQUIRE=强制客户端证书。
# 设为 REQUIRE 时，设备必须持有由 trust-store 内 CA 签发的客户端证书，并需配置下方 trust-store。
FIREFLY_MQTT_CLIENT_AUTH=NONE
FIREFLY_MQTT_TRUST_STORE_TYPE=JKS
# 例：/etc/firefly/certs/mqtt-device-ca.jks
FIREFLY_MQTT_TRUST_STORE_PATH=
FIREFLY_MQTT_TRUST_STORE_PASSWORD=
# 允许的 TLS 协议版本，逗号分隔；默认只允许 TLSv1.2/TLSv1.3。
FIREFLY_MQTT_PROTOCOLS=TLSv1.2,TLSv1.3
# Leave blank to auto-generate from POD_NAME / HOSTNAME / HOST + port.
FIREFLY_MQTT_NODE_ID=
# Leave blank to use the default group: firefly-connector-mqtt-downstream.
FIREFLY_MQTT_DOWNSTREAM_GROUP=
FIREFLY_MQTT_ROUTE_TTL_SECONDS=120
FIREFLY_MQTT_ROUTE_REFRESH_INTERVAL_SECONDS=30
FIREFLY_MQTT_NODE_HEARTBEAT_TTL_SECONDS=45
FIREFLY_MQTT_NODE_HEARTBEAT_INTERVAL_SECONDS=15
FIREFLY_MQTT_DOWNSTREAM_QOS=1
FIREFLY_MQTT_RELAY_CHANNEL_PREFIX=connector:mqtt:downstream:
# 外部 Broker 回调 webhook 令牌（兼容外部 MQTT Broker 时配置；内置 Broker 不需要）
FIREFLY_MQTT_WEBHOOK_TOKEN=
# LoRaWAN 网络服务器回调 webhook 令牌
FIREFLY_LORAWAN_WEBHOOK_TOKEN=

# ---------- ZLMediaKit ----------
# Compose now builds a pinned ZLMediaKit 8.0 image locally instead of pulling
# `zlmediakit/zlmediakit:master`, so the REST API continues to use `secret=...`.
# `ZLM_HOST` / `ZLM_PUBLIC_HOST` must be reachable by cameras and browsers.
# Local debugging can keep `localhost`; production should use the server IP or DNS.
ZLM_HOST=localhost
ZLM_PUBLIC_HOST=localhost
ZLM_API_HOST=zlmediakit
ZLM_API_PORT=80
ZLM_PORT=18080
ZLM_PUBLIC_PORT=18080
ZLM_SSL_PORT=18443
ZLM_PUBLIC_SSL_PORT=18443
ZLM_RTSP_PORT=18554
ZLM_RTMP_PORT=1935
ZLM_RTP_PORT=10000
ZLM_SECRET=035c73f7bb6b4889a715d9eb2d1925cc

# ---------- Mail / Notification ----------
MAIL_HOST=smtp.example.com
MAIL_PORT=465
MAIL_USERNAME=
MAIL_PASSWORD=

# ---------- Frontend ----------
VITE_API_BASE_URL=/api

# ---------- Kafka 消费失败重试 ----------
# 消费失败重试次数（不含首次消费）与间隔；耗尽后投递 <topic>.dlt
FIREFLY_KAFKA_CONSUMER_RETRY_MAX_ATTEMPTS=3
FIREFLY_KAFKA_CONSUMER_RETRY_INTERVAL_MS=1000

# ---------- Observability（Prometheus / Alertmanager / Grafana）----------
PROMETHEUS_PORT=9090
PROMETHEUS_RETENTION=15d
ALERTMANAGER_PORT=9093
GRAFANA_PORT=3000
GRAFANA_ADMIN_PASSWORD=admin
PROMETHEUS_VOLUME_NAME=firefly-prometheus-data
ALERTMANAGER_VOLUME_NAME=firefly-alertmanager-data
GRAFANA_VOLUME_NAME=firefly-grafana-data

# ---------- OTA 固件签名校验 ----------
# PEM 格式公钥；配置后固件可携带 RSA-SHA256 签名（对 SHA-256 摘要签名）
FIREFLY_OTA_SIGNATURE_PUBLIC_KEY=
FIREFLY_OTA_SIGNATURE_ALGORITHM=SHA256withRSA

# 按租户在线设备指标刷新间隔（毫秒）
FIREFLY_METRICS_DEVICE_ONLINE_REFRESH_INTERVAL_MS=30000

# 设备影子 Redis 缓存 TTL（天）与设备级锁 TTL（毫秒）
FIREFLY_SHADOW_REDIS_TTL_DAYS=7
FIREFLY_SHADOW_LOCK_TTL_MS=3000

# 通知渠道投递重试：最大尝试次数与退避基数（毫秒）
FIREFLY_NOTIFICATION_MAX_ATTEMPTS=3
FIREFLY_NOTIFICATION_RETRY_BACKOFF_MS=200

# ---------- 日志保留清理 ----------
# 设备日志/设备事件/操作日志/审计日志的保留天数与清理任务 cron。
# 清理任务使用 Redis 分布式锁，多副本部署时同一时刻仅一个实例执行。
# cron 含空格，Docker .env 解析支持不加大写引号，保持与 JAVA_OPTS 一致。
FIREFLY_LOGS_DEVICE_LOG_RETENTION_DAYS=30
FIREFLY_LOGS_DEVICE_EVENT_RETENTION_DAYS=90
FIREFLY_LOGS_OPERATION_LOG_RETENTION_DAYS=90
FIREFLY_LOGS_AUDIT_LOG_RETENTION_DAYS=180
FIREFLY_LOGS_RETENTION_CLEANUP_CRON=0 20 3 * * ?

# 下行待投递队列（设备离线/无路由时暂存，重连补发）
FIREFLY_DOWNLINK_PENDING_MAX_PER_DEVICE=100
FIREFLY_DOWNLINK_PENDING_TTL_HOURS=24
FIREFLY_DOWNLINK_SEEN_TTL_MINUTES=60
FIREFLY_DOWNLINK_FLUSH_BATCH_SIZE=50

# 连续聚合（CAGG）缺口补刷
FIREFLY_TELEMETRY_CAGG_REFRESH_ENABLED=true
FIREFLY_TELEMETRY_CAGG_REFRESH_ON_STARTUP=true
FIREFLY_TELEMETRY_CAGG_REFRESH_CRON=0 30 3 * * ?
FIREFLY_TELEMETRY_CAGG_REFRESH_BATCH_HOURS=24
FIREFLY_TELEMETRY_CAGG_REFRESH_MAX_LOOKBACK_DAYS=30
FIREFLY_TELEMETRY_CAGG_REFRESH_OVERLAP_MINUTES=10
