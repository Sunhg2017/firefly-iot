<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.songhg.firefly.iot.device.mapper.DeviceLogMapper">

    <!--
      定时保留清理：按创建时间删除过期设备日志的一批数据。
      1) 时间基准使用数据库 now()，避免应用节点与数据库时钟偏差导致清理边界不一致；
      2) 子查询 + LIMIT 限制单批行数，由 LogRetentionJob 循环调用，避免单条 DELETE 长时间持锁；
      3) 该语句由 Job 调用，调度线程没有租户上下文，Mapper 方法上通过
         @InterceptorIgnore(tenantLine = "true") 跳过租户行级隔离，执行全局清理。
    -->
    <delete id="deleteExpiredBatch">
        DELETE FROM device_logs
        WHERE id IN (
            SELECT id
            FROM device_logs
            WHERE created_at &lt; now() - make_interval(days =&gt; #{retentionDays})
            ORDER BY created_at
            LIMIT #{batchSize}
        )
    </delete>

</mapper>
